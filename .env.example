# Reddit API credentials (create app at https://www.reddit.com/prefs/apps - type: "script")
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=redditbot:v1.0 (by /u/your_reddit_username)

# Groq API key (free, no credit card - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key

# Google Gemini API key (free fallback - https://ai.google.dev)
GEMINI_API_KEY=your_gemini_api_key
