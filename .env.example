# Reddit credentials (just your username and password - no API keys needed)
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=redditbot:v1.0 (by /u/your_reddit_username)

# Groq API key (free, no credit card - https://console.groq.com)
GROQ_API_KEY=

# Google Gemini API key (free fallback - https://ai.google.dev)
GEMINI_API_KEY=

# OpenAI API key (paid fallback, very cheap - https://platform.openai.com/api-keys)
OPENAI_API_KEY=
